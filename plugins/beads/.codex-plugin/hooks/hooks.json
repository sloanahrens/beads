{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime",
            "statusMessage": "Loading Beads context"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime --memories-only",
            "statusMessage": "Checking Beads context"
          }
        ]
      }
    ]
  }
}
