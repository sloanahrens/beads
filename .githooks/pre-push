#!/usr/bin/env bash
# Pre-push hook: when pushing a release tag (refs/tags/v*), refuse the push if
# version constants disagree. This stops a release from being tagged/published
# with drifted versions (the failure mode that left main red after the 1.0.5
# release) before it ever reaches CI.
#
# Installed via: git config core.hooksPath .githooks
# See also: make install (sets hooksPath automatically)
#
# Bypass (not recommended for release tags): git push --no-verify

set -euo pipefail

# git feeds "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
# Capture it so the chained beads hook at the bottom still sees the ref list.
push_refs="$(cat)"

# An up-to-date push (and other no-op pushes) feeds pre-push EMPTY stdin. The
# per-ref checks below are meaningless with no refs and would fall through the
# allowlist's reject arm with an empty branch name - "Blocked push to: " - a
# confusing refusal for a push git would no-op anyway. Exit clean: nothing to
# gate, and the chained beads hook below needs no refs either.
if [[ -z "$push_refs" ]]; then
  exit 0
fi

# --- BEGIN BEADS BRANCH ALLOWLIST + POLECAT MAIN-PUSH REFUSAL (gt-93od) ---
# Default branch detection falls back to the same chain the Go side uses
# (git.RemoteDefaultBranch): origin/HEAD symref, then origin/master, then
# origin/main.
default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's#refs/remotes/origin/##')
if [[ -z "$default_branch" ]]; then
  if git rev-parse --verify origin/master &>/dev/null; then
    default_branch=master
  else
    default_branch=main
  fi
fi

# is_polecat_caller reports whether the process running this hook belongs to a
# polecat, as opposed to crew / refinery / mayor / witness / any non-agent
# caller. Two independent signals, either one is enough:
#
#   GT_ROLE - set by the session manager at spawn: "polecat", or the compound
#             form "<rig>/polecats/<name>".
#   $PWD    - for a polecat push the hook runs inside the polecat's own
#             worktree, <town>/<rig>/polecats/<name>/<repo>.
#
# GT_POLECAT is deliberately NOT a signal: coordinators can carry a stale
# GT_POLECAT in their environment (sling treats GT_ROLE as the authoritative
# polecat check for exactly that reason), and a false positive here would
# refuse the Refinery's own merge or a crew member's legitimate push.
is_polecat_caller() {
  case "${GT_ROLE:-}" in
    polecat|*/polecats/*) return 0 ;;
  esac
  case "${PWD:-}" in
    */polecats/*) return 0 ;;
  esac
  return 1
}

# is_refinery_caller reports whether this process's env signals look like the
# Refinery, using the same two signals the Go side treats as authoritative for
# that role (isRefineryRole, internal/cmd/tap_guard.go). This is a
# plausibility check, not authentication: GT_REFINERY and GT_ROLE are
# ordinary environment variables any process in this shell can export. A
# polecat-shaped GT_ROLE disqualifies the claim outright (gt-9tf9), since it
# directly contradicts a Refinery identity; nothing here stops a hand-crafted
# non-polecat environment from spoofing the rest. Closing that for real needs
# a server-side backstop (branch protection with a Refinery-only push
# identity), tracked separately (gt-wvp3c).
#
#   GT_REFINERY  - set on the tmux session env at Refinery spawn
#                  (internal/refinery/manager.go), mirroring GT_POLECAT_PATH
#                  for polecats.
#   GT_ROLE      - "refinery" or the compound "<rig>/refinery" form.
is_refinery_caller() {
  case "${GT_ROLE:-}" in
    polecat|*/polecats/*) return 1 ;;
  esac
  [[ -n "${GT_REFINERY:-}" ]] && return 0
  case "${GT_ROLE:-}" in
    refinery|*/refinery) return 0 ;;
  esac
  return 1
}

# is_polecat_main_push_allowed reports whether this particular push to the
# default branch, from a caller is_polecat_caller already flagged as a
# polecat, is one of the two deliberate, gate-checked pushes that role is
# sanctioned to make:
#
#   GT_REFINERY_MERGE=1    - the Refinery's merge (gt's refinery sets this on
#                            its own merge push, internal/refinery/batch.go,
#                            internal/refinery/engineer.go). Requires
#                            is_refinery_caller corroboration; refused without
#                            it (gt-9tf9).
#   GT_DONE_DIRECT_MERGE=1 - `gt done` landing a convoy whose merge_strategy is
#                            "direct" (internal/cmd/done.go), which deliberately
#                            runs inside a polecat's own session, so there is no
#                            separate identity to require. It stays a bare
#                            env-var trust boundary: a hostile or hand-typed
#                            polecat session can still export this name and
#                            push past `gt done`'s own eligibility checks.
#                            Closing that gap needs a server-side backstop
#                            (branch protection with a Refinery-only push
#                            identity); tracked as gt-wvp3c, not fixed here.
#
# A legitimate call site sets exactly one of these per push, so both set at
# once is refused rather than trusted - it only catches a contradictory/
# hand-crafted env (gt-9tf9).
is_polecat_main_push_allowed() {
  local refinery_flag=0 direct_flag=0
  [[ "${GT_REFINERY_MERGE:-0}" == "1" ]] && refinery_flag=1
  [[ "${GT_DONE_DIRECT_MERGE:-0}" == "1" ]] && direct_flag=1

  if [[ "$refinery_flag" == "1" && "$direct_flag" == "1" ]]; then
    return 1
  fi

  if [[ "$refinery_flag" == "1" ]]; then
    is_refinery_caller && return 0
    return 1
  fi

  [[ "$direct_flag" == "1" ]] && return 0

  return 1
}

# describe_main_push_denial prints the extra diagnostic line(s) explaining WHY
# an env var that looked like an allow signal did not grant one, so the
# operator sees "identity mismatch" or "both flags set" instead of just
# guessing from the generic refusal banner below.
describe_main_push_denial() {
  if [[ "${GT_REFINERY_MERGE:-0}" == "1" && "${GT_DONE_DIRECT_MERGE:-0}" == "1" ]]; then
    echo "Both GT_REFINERY_MERGE=1 and GT_DONE_DIRECT_MERGE=1 are set. No gt code path"
    echo "sets both for the same push, so this looks tampered rather than legitimate -"
    echo "refusing rather than guessing which one to trust (gt-9tf9)."
    echo ""
  elif [[ "${GT_REFINERY_MERGE:-0}" == "1" ]]; then
    echo "GT_REFINERY_MERGE=1 was set, but this session's identity doesn't look like"
    echo "the Refinery (GT_REFINERY=${GT_REFINERY:-<unset>}, GT_ROLE=${GT_ROLE:-<unset>})."
    echo "The env var alone is not enough to grant this (gt-9tf9) - it must come from"
    echo "an actual Refinery session."
    echo ""
  fi
}

while read -r local_ref _local_sha remote_ref _remote_sha; do
  # Tags and notes are not branches - the release-tag check below (and the
  # allowlist for notes) handles them separately.
  [[ "$remote_ref" == refs/tags/* ]] && continue
  [[ "$remote_ref" == refs/notes/* ]] && continue

  branch="${remote_ref#refs/heads/}"

  # Polecat main-push refusal (gt-93od, ported from gastown, gt-ibt8).
  # Checked before the off-branch guard below so a polecat's
  # `git push origin main` gets the message that names the real remedy
  # (gt done) rather than the generic HEAD-mismatch one.
  if [[ "$branch" == "$default_branch" ]] && is_polecat_caller && ! is_polecat_main_push_allowed; then
    echo "BLOCKED: polecats never push to '$default_branch'."
    echo ""
    echo "A polecat's work lands through the merge queue, never as a direct push -"
    echo "a direct push to '$default_branch' skips the MR, the Refinery's gate run,"
    echo "and the om review (gt-ibt8: granite pushed origin/$default_branch from a"
    echo "detached HEAD this way on 09-17 in the gastown rig)."
    echo ""
    echo "  Right:  gt done          # pushes polecat/<name>/<bead> and submits an MR"
    echo "  Wrong:  git push origin HEAD:$default_branch"
    echo ""
    echo "The Refinery merges to $default_branch after verification."
    echo "Detected as a polecat via GT_ROLE=${GT_ROLE:-<unset>} and cwd $PWD."
    echo ""
    describe_main_push_denial
    echo "If this push is a legitimate landing (Refinery merge, or a gt done"
    echo "direct-merge convoy) it must come from that gt code path, which sets"
    echo "GT_REFINERY_MERGE=1 / GT_DONE_DIRECT_MERGE=1 for this push."
    echo ""
    echo "Two other flows push the default branch and get no env signal here,"
    echo "because a signal an agent sets for itself is a user override, not a"
    echo "gate (gt-deff):"
    echo "  - a release push (beads-release 'push-main')"
    echo "  - a plugin script's own push, when an agent runs its instructions"
    echo "      (plugins write both, but the daemon runs them as GT_ROLE=daemon/plugin"
    echo "       and is not a polecat caller - this only bites a manual run)"
    echo "Both belong to a crew, mayor, or refinery session. Run them there."
    exit 1
  fi

  # HEAD-mismatch guard: refuse pushing a branch you are not standing on.
  # `git push origin <B>` pushes the local <B> ref regardless of where HEAD is, so
  # running it from a session/feature branch silently no-ops ("Everything up-to-date")
  # or pushes a stale ref — the work is stranded on a branch nobody merges. Git's
  # conflict model can't catch this: it happens before any divergence exists.
  # Only fires when a local branch ref is being pushed (not HEAD:x, tags, or deletes).
  # Override for intentional cross-branch pushes: GT_ALLOW_OFFBRANCH_PUSH=1
  if [[ "${GT_ALLOW_OFFBRANCH_PUSH:-0}" != "1" \
        && "$local_ref" == refs/heads/* \
        && "$_local_sha" != "0000000000000000000000000000000000000000" ]]; then
    head_branch=$(git symbolic-ref --short -q HEAD || echo "")
    pushed_branch="${local_ref#refs/heads/}"
    if [[ -n "$head_branch" && "$head_branch" != "$pushed_branch" ]]; then
      echo "BLOCKED: pushing '$pushed_branch' while HEAD is on '$head_branch'."
      echo ""
      echo "You are not on the branch you are pushing. This commonly no-ops silently"
      echo "(\"Everything up-to-date\") or pushes a stale ref, leaving the real work"
      echo "stranded on a branch nobody merges."
      echo ""
      echo "  Check:  git status -sb ; git reflog | head"
      echo "  Fix:    git switch '$pushed_branch'   (then re-push)"
      echo "  Intentional cross-branch push? re-run with GT_ALLOW_OFFBRANCH_PUSH=1"
      exit 1
    fi
  fi

  # Branch allowlist.
  case "$branch" in
    "${default_branch}"|beads-sync|polecat/*|integration/*)
      # Allowed branches
      ;;
    *)
      # Allow feature branches when contributing to upstream (fork workflow).
      # If an 'upstream' remote exists, this is a contribution setup where
      # feature branches are needed for PRs.
      if ! git remote get-url upstream &>/dev/null; then
        echo "ERROR: Invalid branch for Gas Town agents."
        echo ""
        echo "Blocked push to: $branch"
        echo ""
        echo "Allowed branches:"
        echo "  ${default_branch}        - Crew workers push here directly"
        echo "  polecat/*   - Polecat working branches"
        echo "  integration/* - Integration branches"
        echo "  beads-sync  - Beads synchronization"
        echo ""
        echo "Do NOT create PRs. Push to main or let Refinery merge polecat work."
        exit 1
      fi
      ;;
  esac
done <<< "$push_refs"
# --- END BEADS BRANCH ALLOWLIST + POLECAT MAIN-PUSH REFUSAL (gt-93od) ---


pushing_version_tag=0
while read -r local_ref _local_sha _remote_ref _remote_sha; do
    case "$local_ref" in
        refs/tags/v[0-9]*) pushing_version_tag=1 ;;
    esac
done <<< "$push_refs"

if [ "$pushing_version_tag" -eq 1 ]; then
    repo_root="$(git rev-parse --show-toplevel)"
    # Skip on older checkouts without the consistency check; do not block.
    if [ -x "$repo_root/scripts/check-versions.sh" ]; then
        echo "Release tag push detected — verifying version consistency..."
        if ! (cd "$repo_root" && ./scripts/check-versions.sh); then
            echo ""
            echo "❌ Refusing to push release tag: versions are inconsistent." >&2
            echo "   Fix with: scripts/update-versions.sh <version>" >&2
            echo "   Override with --no-verify only if you know what you are doing." >&2
            exit 1
        fi
    fi
fi

exec < <(printf '%s\n' "$push_refs")

# --- BEGIN BEADS INTEGRATION v1.2.2 ---
# This section is managed by beads. Do not remove these markers.
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  _bd_timeout=${BEADS_HOOK_TIMEOUT:-300}
  case "$_bd_timeout" in
    *[!0-9]*|'') _bd_timeout_invalid=1 ;;
    *[1-9]*) _bd_timeout_invalid=0 ;;
    *) _bd_timeout_invalid=1 ;;
  esac
  if [ "$_bd_timeout_invalid" -eq 1 ]; then
    echo >&2 "beads: invalid BEADS_HOOK_TIMEOUT; using 300 seconds"
    _bd_timeout=300
  fi
  _bd_timeout_backend=none
  _bd_timeout_command=
  for _bd_timeout_candidate in timeout gtimeout; do
    if command -v "$_bd_timeout_candidate" >/dev/null 2>&1; then
      if _bd_timeout_version="$("$_bd_timeout_candidate" --version 2>/dev/null)"; then
        case "$_bd_timeout_version" in
          "timeout (GNU coreutils) "*) _bd_timeout_command=$_bd_timeout_candidate; break ;;
        esac
      fi
    fi
  done
  if [ -n "$_bd_timeout_command" ]; then
    _bd_timeout_backend=coreutils
    if "$_bd_timeout_command" -- "$_bd_timeout" bd hooks run pre-push "$@"; then
      _bd_exit=0
    else
      _bd_exit=$?
    fi
  elif command -v perl >/dev/null 2>&1; then
    _bd_timeout_backend=perl
    if perl -e 'alarm shift; exec @ARGV' -- "$_bd_timeout" bd hooks run pre-push "$@"; then
      _bd_exit=0
    else
      _bd_exit=$?
    fi
  else
    echo >&2 "beads: hook 'pre-push' running without timeout; install coreutils or perl to enable BEADS_HOOK_TIMEOUT"
    if bd hooks run pre-push "$@"; then
      _bd_exit=0
    else
      _bd_exit=$?
    fi
  fi
  if { [ "$_bd_timeout_backend" = coreutils ] && [ "$_bd_exit" -eq 124 ]; } || { [ "$_bd_timeout_backend" = perl ] && [ "$_bd_exit" -eq 142 ]; }; then
    echo >&2 "beads: hook 'pre-push' timed out after ${_bd_timeout}s — continuing without beads"
    _bd_exit=0
  fi
  if [ "$_bd_exit" -eq 3 ]; then
    echo >&2 "beads: database not initialized — skipping hook 'pre-push'"
    _bd_exit=0
  fi
  if [ "$_bd_exit" -ne 0 ]; then exit "$_bd_exit"; fi
fi
# --- END BEADS INTEGRATION v1.2.2 ---
